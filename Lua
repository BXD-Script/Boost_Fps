local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local UserSettings = UserSettings()
local GameSettings = UserSettings.GameSettings

print("เปิดใช้งาน FPS Boost ครั้งเดียว...")

pcall(function()
    pcall(function()
        if UserSettings and UserSettings.GameSettings then
            UserSettings.GameSettings.RenderQuality = 1
            UserSettings.GameSettings.MaterialQuality = 1
            UserSettings.GameSettings.ParticleQuality = 1
            UserSettings.GameSettings.TextureQuality = 1
            UserSettings.GameSettings.WaterQuality = 1
        end
    end)

    Lighting.GlobalShadows = false
    Lighting.FogEnd = 999999
    Lighting.Brightness = 1

    for _, v in ipairs(Lighting:GetChildren()) do
        if v:IsA("PostEffect") or v:IsA("Atmosphere") or v:IsA("Sky") then
            v:Destroy()
        end
    end

    local function ProcessParts()
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") then
                obj.Material = Enum.Material.SmoothPlastic
                obj.CastShadow = false
            elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Fire") or obj:IsA("Smoke") then
                obj.Enabled = false
            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                obj.Transparency = 1
            end
        end
    end

    ProcessParts()

    Workspace.DescendantAdded:Connect(function(obj)
        if obj:IsA("BasePart") then
            obj.Material = Enum.Material.SmoothPlastic
            obj.CastShadow = false
        elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Fire") or obj:IsA("Smoke") then
            obj.Enabled = false
        elseif obj:IsA("Decal") or obj:IsA("Texture") then
            obj.Transparency = 1
        end
    end)

    print("ปรับแต่งเสร็จสิ้น")
end)
